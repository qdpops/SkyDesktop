diff --git a/src/fec.rs b/src/fec.rs
new file mode 100644
index 0000000..d63f597
--- /dev/null
+++ b/src/fec.rs
@@ -0,0 +1,78 @@
+//! SkyDesktop FEC: прямая коррекция ошибок для UDP-транспорта.
+//!
+//! Политика из плана (раздел 4.4):
+//! - потери > 5% → Reed-Solomon, избыточность 20%, блок 8 пакетов
+//! - потери > 1% → XOR, избыточность 10%, блок 16 пакетов
+//! - иначе        → без FEC
+//!
+//! Точка интеграции: `udp::FramedStream::send` / `send_raw`.
+
+/// Тип FEC-кодирования.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum FecType {
+    None,
+    Xor,
+    ReedSolomon,
+}
+
+/// Параметры FEC для текущего канала.
+#[derive(Debug, Clone, Copy)]
+pub struct FecParams {
+    pub redundancy_pct: u8,
+    pub block_size: u8,
+    pub fec_type: FecType,
+}
+
+impl FecParams {
+    pub fn disabled() -> Self {
+        Self {
+            redundancy_pct: 0,
+            block_size: 32,
+            fec_type: FecType::None,
+        }
+    }
+
+    /// Выбор FEC по проценту потерь пакетов.
+    pub fn from_loss(packet_loss_pct: f32) -> Self {
+        if packet_loss_pct > 5.0 {
+            Self {
+                redundancy_pct: 20,
+                block_size: 8,
+                fec_type: FecType::ReedSolomon,
+            }
+        } else if packet_loss_pct > 1.0 {
+            Self {
+                redundancy_pct: 10,
+                block_size: 16,
+                fec_type: FecType::Xor,
+            }
+        } else {
+            Self::disabled()
+        }
+    }
+
+    /// Включён ли FEC.
+    pub fn enabled(&self) -> bool {
+        !matches!(self.fec_type, FecType::None)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn high_loss_uses_reed_solomon() {
+        let p = FecParams::from_loss(6.0);
+        assert_eq!(p.fec_type, FecType::ReedSolomon);
+        assert_eq!(p.redundancy_pct, 20);
+        assert!(p.enabled());
+    }
+
+    #[test]
+    fn low_loss_disables_fec() {
+        let p = FecParams::from_loss(0.5);
+        assert_eq!(p.fec_type, FecType::None);
+        assert!(!p.enabled());
+    }
+}
