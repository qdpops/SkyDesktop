+        if pool.is_empty() {
+            return Vec::new();
+        }
+        // Порт дописывается, чтобы «host» и «host:21116» не попали в список дважды.
+        let with_port = |s: &str| -> String {
+            let s = s.trim();
+            let has_port = s
+                .rfind(':')
+                .map(|i| !s[i + 1..].is_empty() && s[i + 1..].bytes().all(|b| b.is_ascii_digit()))
+                .unwrap_or(false);
+            if has_port {
+                s.to_owned()
+            } else {
+                format!("{s}:{RENDEZVOUS_PORT}")
+            }
+        };
+
+        let mut servers = Vec::new();
+        let seed = Self::get_option(keys::OPTION_CUSTOM_RENDEZVOUS_SERVER);
+        if !seed.is_empty() {
+            servers.push(with_port(&seed));
+        }
+        for host in pool.split(',').filter(|x| x.contains('.')) {
+            let host = with_port(host);
+            if !servers.contains(&host) {
+                servers.push(host);
+            }
+        }
+        servers
+    }
