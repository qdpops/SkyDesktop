diff --git a/src/skydesktop_quality.rs b/src/skydesktop_quality.rs
new file mode 100644
index 0000000..0062037
--- /dev/null
+++ b/src/skydesktop_quality.rs
@@ -0,0 +1,190 @@
+//! SkyDesktop: адаптивный контроллер качества для RustDesk.
+//!
+//! Расширяет штатный `server::video_qos` (регулировка только по задержке)
+//! полноценной адаптацией: классификация канала по bandwidth/latency/loss/jitter,
+//! выбор кодека, цветности, битрейта, FPS, HDR и FEC.
+//!
+//! Порядок применения решения — в `server::video_qos::VideoQoS`:
+//! - `QualityDecision::target_ratio()` → `VideoQoS::ratio` (через `set_quality` энкодера)
+//! - `QualityDecision::fps`          → `VideoQoS::fps`
+//! - кодек/цветность/HDR/FEC        → передаются в encoder/транспорт (см. комментарии в video_qos.rs)
+
+/// Метрики канала в реальном времени.
+#[derive(Debug, Clone, Copy)]
+pub struct ChannelMetrics {
+    /// Пропускная способность, Мбит/с.
+    pub bandwidth_mbps: f32,
+    /// Задержка, мс.
+    pub latency_ms: f32,
+    /// Потери пакетов, %.
+    pub packet_loss_pct: f32,
+    /// Джиттер, мс.
+    pub jitter_ms: f32,
+}
+
+/// Уровень качества канала.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ChannelLevel {
+    Excellent,
+    Good,
+    Medium,
+    Poor,
+}
+
+impl ChannelMetrics {
+    pub fn new(bandwidth_mbps: f32, latency_ms: f32, packet_loss_pct: f32, jitter_ms: f32) -> Self {
+        Self {
+            bandwidth_mbps,
+            latency_ms,
+            packet_loss_pct,
+            jitter_ms,
+        }
+    }
+
+    pub fn level(&self) -> ChannelLevel {
+        if self.latency_ms < 20.0 && self.packet_loss_pct < 0.5 && self.bandwidth_mbps > 50.0 {
+            ChannelLevel::Excellent
+        } else if self.latency_ms < 40.0 && self.packet_loss_pct < 2.0 && self.bandwidth_mbps > 15.0 {
+            ChannelLevel::Good
+        } else if self.latency_ms < 80.0 && self.packet_loss_pct < 5.0 && self.bandwidth_mbps > 5.0 {
+            ChannelLevel::Medium
+        } else {
+            ChannelLevel::Poor
+        }
+    }
+}
+
+/// Кодек, выбираемый адаптивным контроллером.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum SkyCodec {
+    AV1,
+    H265,
+    H264,
+}
+
+/// Цветовая субдискретизация.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum SkyChroma {
+    I444,
+    I420,
+}
+
+/// Решение адаптивного контроллера.
+#[derive(Debug, Clone)]
+pub struct QualityDecision {
+    pub codec: SkyCodec,
+    pub chroma: SkyChroma,
+    pub bitrate_mbps: u32,
+    pub fps: u32,
+    pub hdr: bool,
+    pub fec: bool,
+}
+
+impl QualityDecision {
+    /// Маппинг битрейта на «ratio» RustDesk (`scrap::codec`):
+    /// BR_BEST=1.5, BR_BALANCED=0.67, BR_SPEED=0.5, BR_MIN_HIGH_RESOLUTION=0.1.
+    /// 120 Мбит/с принято за эталонный максимум (ratio = 1.0).
+    pub fn target_ratio(&self) -> f32 {
+        (self.bitrate_mbps as f32 / 120.0).clamp(0.1, 1.5)
+    }
+}
+
+/// Адаптивный контроллер качества (план 4.2).
+pub struct AdaptiveQualityController {
+    metrics: ChannelMetrics,
+}
+
+impl AdaptiveQualityController {
+    pub fn new(metrics: ChannelMetrics) -> Self {
+        Self { metrics }
+    }
+
+    pub fn update_metrics(&mut self, metrics: ChannelMetrics) {
+        self.metrics = metrics;
+    }
+
+    pub fn metrics(&self) -> ChannelMetrics {
+        self.metrics
+    }
+
+    /// Отличный канал — максимальное качество, слабый — сжатие.
+    pub fn optimize(&self) -> QualityDecision {
+        let m = &self.metrics;
+        match self.metrics.level() {
+            ChannelLevel::Excellent => QualityDecision {
+                codec: SkyCodec::AV1,
+                chroma: SkyChroma::I444,
+                bitrate_mbps: (m.bandwidth_mbps * 0.9).clamp(60.0, 200.0) as u32,
+                fps: 60,
+                hdr: true,
+                fec: false,
+            },
+            ChannelLevel::Good => QualityDecision {
+                codec: SkyCodec::H265,
+                chroma: SkyChroma::I420,
+                bitrate_mbps: (m.bandwidth_mbps * 0.7).clamp(15.0, 80.0) as u32,
+                fps: 45,
+                hdr: true,
+                fec: true,
+            },
+            ChannelLevel::Medium => QualityDecision {
+                codec: SkyCodec::H265,
+                chroma: SkyChroma::I420,
+                bitrate_mbps: (m.bandwidth_mbps * 0.6).clamp(5.0, 30.0) as u32,
+                fps: 30,
+                hdr: false,
+                fec: true,
+            },
+            ChannelLevel::Poor => QualityDecision {
+                codec: SkyCodec::H264,
+                chroma: SkyChroma::I420,
+                bitrate_mbps: (m.bandwidth_mbps * 0.5).clamp(2.0, 10.0) as u32,
+                fps: 24,
+                hdr: false,
+                fec: true,
+            },
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn metrics_for(level: ChannelLevel) -> ChannelMetrics {
+        match level {
+            ChannelLevel::Excellent => ChannelMetrics::new(480.0, 8.0, 0.1, 2.0),
+            ChannelLevel::Good => ChannelMetrics::new(60.0, 22.0, 0.7, 5.0),
+            ChannelLevel::Medium => ChannelMetrics::new(14.0, 48.0, 2.4, 13.0),
+            ChannelLevel::Poor => ChannelMetrics::new(4.5, 96.0, 6.8, 29.0),
+        }
+    }
+
+    #[test]
+    fn excellent_channel_uses_max_quality() {
+        let d = AdaptiveQualityController::new(metrics_for(ChannelLevel::Excellent)).optimize();
+        assert_eq!(d.codec, SkyCodec::AV1);
+        assert_eq!(d.chroma, SkyChroma::I444);
+        assert_eq!(d.fps, 60);
+        assert!(d.hdr);
+        assert!(!d.fec);
+    }
+
+    #[test]
+    fn poor_channel_compresses() {
+        let d = AdaptiveQualityController::new(metrics_for(ChannelLevel::Poor)).optimize();
+        assert_eq!(d.codec, SkyCodec::H264);
+        assert_eq!(d.chroma, SkyChroma::I420);
+        assert!(d.fps <= 24);
+        assert!(d.bitrate_mbps <= 10);
+        assert!(d.fec);
+    }
+
+    #[test]
+    fn ratio_mapping_matches_rustdesk_constants() {
+        let d = AdaptiveQualityController::new(metrics_for(ChannelLevel::Excellent)).optimize();
+        assert!((d.target_ratio() - 1.5).abs() < f32::EPSILON);
+        let d = AdaptiveQualityController::new(metrics_for(ChannelLevel::Poor)).optimize();
+        assert!(d.target_ratio() >= 0.1);
+    }
+}
