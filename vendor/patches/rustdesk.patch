+
+/// Both the encoder setup and the "should we rebuild the encoder" check must
+/// derive i444 the same way, otherwise they disagree forever and the video
+/// service restarts on every frame. i444 also stays off unless the peer
+/// negotiated it — forcing it would leave the peer with no image at all.
+fn adaptive_use_i444(encoder_cfg: &EncoderCfg) -> bool {
+    let negotiated = Encoder::use_i444(encoder_cfg);
+    match adaptive_decision() {
+        Some(decision) => {
+            negotiated && matches!(decision.chroma, crate::skydesktop_quality::SkyChroma::I444)
+        }
+        None => negotiated,
+    }
