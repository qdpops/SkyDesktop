+    /// SkyDesktop: принудительная установка кодека по решению адаптивного
+    /// контроллера качества. Вызывается из `server::video_service` до того,
+    /// как видеослужба запомнит текущий формат, иначе проверка «формат
+    /// сменился» перезапускала бы кодировщик на каждом кадре.
+    ///
+    /// Решение применяется, только если пир умеет декодировать этот формат:
+    /// иначе картинки просто не будет.
+    pub fn set_adaptive_codec(format: CodecFormat) {
+        if !Self::peer_can_decode(&format) {
+            log::debug!("SkyDesktop adaptive codec {format:?} не поддержан пиром, оставляем прежний");
+            return;
+        }
+        let mut current = ENCODE_CODEC_FORMAT.lock().unwrap();
+        if *current != format {
+            log::info!("SkyDesktop adaptive codec: {:?} -> {:?}", *current, format);
+            *current = format;
+        }
+    }
+
+    /// SkyDesktop: умеет ли подключённый пир декодировать данный формат.
+    pub fn peer_can_decode(format: &CodecFormat) -> bool {
+        let decodings = PEER_DECODINGS.lock().unwrap();
+        if decodings.is_empty() {
+            return false;
+        }
+        match format {
+            CodecFormat::VP8 => decodings.iter().all(|d| d.1.ability_vp8 > 0),
+            CodecFormat::VP9 => decodings.iter().all(|d| d.1.ability_vp9 > 0),
+            CodecFormat::AV1 => decodings.iter().all(|d| d.1.ability_av1 > 0),
+            CodecFormat::H264 => decodings.iter().all(|d| d.1.ability_h264 > 0),
+            CodecFormat::H265 => decodings.iter().all(|d| d.1.ability_h265 > 0),
+            _ => false,
+        }
+    }
